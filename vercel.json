{
  "builds": [
    {
      "src": "kos-web/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "backend/api.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "backend/api.py"
    },
    {
      "source": "/(.*)",
      "destination": "kos-web/$1"
    }
  ]
}
